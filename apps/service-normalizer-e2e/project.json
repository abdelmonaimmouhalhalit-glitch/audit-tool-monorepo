{
  "name": "service-normalizer-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["service-normalizer"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/service-normalizer-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": ["service-normalizer:build", "service-normalizer:serve"]
    }
  }
}
