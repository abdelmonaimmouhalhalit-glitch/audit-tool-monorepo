# -------------------------------------------------------------------
# 1. BASE DE DONNÉES (PostgreSQL) - Crucial pour Prisma
# -------------------------------------------------------------------
# Cette URL doit correspondre EXACTEMENT aux identifiants du docker-compose
DATABASE_URL="postgresql://toly_user:toly_password@localhost:5432/toly_db?schema=public"

# -------------------------------------------------------------------
# 2. STEAMPIPE (Le moteur SQL Cloud)
# -------------------------------------------------------------------
# Utilisé par NestJS pour interroger GitHub/AWS comme une DB
STEAMPIPE_DATABASE_URL="postgresql://steampipe@localhost:9193/steampipe"

# -------------------------------------------------------------------
# 3. AUTHENTIFICATION (Clerk)
# -------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_d2FybS1lZWwtOC5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_Uq0cz7HizVwT58TNArgLW1oL4pjSbzcvM3NnbfiJE0

# -------------------------------------------------------------------
# 4. CONFIGURATION RÉSEAU
# -------------------------------------------------------------------
PORT=3333
NEXT_PUBLIC_API_URL="http://localhost:3333"

# -------------------------------------------------------------------
# 5. INTÉGRATIONS (Exemple pour tes futurs connecteurs)
# -------------------------------------------------------------------
