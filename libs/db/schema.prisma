// libs/db/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- 1. GESTION DES CLIENTS (Tenants) ---

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  
  // Relations
  users        User[]
  integrations Integration[]
  assets       Asset[]
  scanResults  ScanResult[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  clerkId   String   @unique // Lien avec l'Auth Clerk
  role      String   @default("MEMBER") // "ADMIN", "MEMBER"
  
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

// --- 2. CONNEXIONS (Steampipe / APIs) ---

model Integration {
  id        String   @id @default(uuid())
  provider  String   // "GOOGLE_WORKSPACE", "AWS", "GITHUB", "FLEET"
  status    String   @default("DISCONNECTED") // "CONNECTED", "ERROR"
  config    Json?    // Stockage crypté des clés si besoin (ou ref vers env)
  lastSync  DateTime?

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

// --- 3. INVENTAIRE (Ce que Steampipe trouve) ---

model Asset {
  id          String   @id @default(uuid())
  
  externalId  String   // ID unique chez le provider (ex: User ID Google)
  name        String   // ex: "jean.dupont@company.com" ou "prod-db-01"
  type        String   // "USER", "COMPUTE", "DATABASE", "REPOSITORY", "DEVICE", "TICKET", "APP"
  provider    String   // "GOOGLE", "AWS", "GITHUB", "VERCEL", etc.
  
  rawData     Json     // La donnée brute renvoyée par Steampipe
  
  // METADONNEES DE SYNCHRO (C'est ici que tu avais l'erreur)
  lastSeen    DateTime @default(now()) // Quand l'a-t-on vu pour la dernière fois ?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt      // Se met à jour seul quand rawData change

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  
  scanResults ScanResult[] // Historique des audits sur cet asset

  @@unique([companyId, externalId]) // Pas de doublons dans une même boite
}

// --- 4. RÉSULTATS D'AUDIT (Le Vert/Rouge du Dashboard) ---

model ScanResult {
  id          String   @id @default(uuid())
  checkId     String   // ex: "NIS2-MFA-001"
  status      String   // "PASS", "FAIL", "IGNORED"
  evidence    String?  // Message d'erreur ou lien preuve
  lastChecked DateTime @default(now())

  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
}