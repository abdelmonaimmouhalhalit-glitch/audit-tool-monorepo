generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- 1. GESTION DES CLIENTS (Tenants) ---

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  
  users        User[]
  integrations Integration[]
  assets       Asset[]
  scanResults  ScanResult[]
  frameworks   CompanyFramework[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  clerkId   String   @unique
  role      String   @default("MEMBER")
  
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

// --- 2. CONNEXIONS (Steampipe / APIs) ---

model Integration {
  id        String   @id @default(uuid())
  provider  String   
  status    String   @default("DISCONNECTED")
  config    Json?    
  lastSync  DateTime?

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

// --- 3. INVENTAIRE (Assets - La cible du scan) ---

model Asset {
  id          String   @id @default(uuid())
  externalId  String   
  name        String   
  type        String   
  provider    String   
  rawData     Json     
  
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt      

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  
  scanResults ScanResult[] 

  @@unique([companyId, externalId])
}

// --- 4. RÉSULTATS D'AUDIT (Evidence Collection) ---

model ScanResult {
  id          String   @id @default(uuid())
  checkId     String   // Identifiant technique du test (ex: "github_repo_private")
  status      String   // "PASS", "FAIL", "IGNORED"
  evidence    Json?    // Snapshot JSON du problème pour l'auditeur
  lastChecked DateTime @default(now())

  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
}

// --- 5. STRUCTURE GRC (Le Mapping Vanta) ---

model Framework {
  id           String        @id @default(uuid())
  name         String        // "SOC2", "ISO27001", "CIS"
  description  String?
  requirements Requirement[]
  companies    CompanyFramework[]
}

model CompanyFramework {
  id          String    @id @default(uuid())
  companyId   String
  frameworkId String
  company     Company   @relation(fields: [companyId], references: [id])
  framework   Framework @relation(fields: [frameworkId], references: [id])
  status      Float     @default(0) // % de complétion global
}

model Requirement {
  id          String   @id @default(uuid())
  code        String   // "CC6.1" ou "A.5.15"
  description String?
  frameworkId String
  framework   Framework @relation(fields: [frameworkId], references: [id])
  controls    Control[]
}

model Control {
  id           String   @id @default(uuid())
  name         String   // "Enforce MFA on GitHub"
  description  String?
  requirementId String
  requirement  Requirement @relation(fields: [requirementId], references: [id])
  automatedTests AutomatedTest[]
}

model AutomatedTest {
  id        String   @id @default(uuid())
  checkId   String   // Lien technique avec ScanResult.checkId
  controlId String
  control   Control  @relation(fields: [controlId], references: [id])
}